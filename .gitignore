# Everything in output/ is generated by the scripts and can be re-made at any time,
# so we don't save it in Git (it would just bloat the history).
output/

# Python leftovers
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS clutter
.vscode/
.DS_Store
Thumbs.db

# The full Ville de Montréal file is too big for GitHub (78 MB): only the slice in data/ is needed
ego_puisard_p.csv

# Written by sensor_bridge.py on each computer (which port, last reading)
data/sensor_status.json

# Wi-Fi password and upload key for the ESP8266 sketch
arduino/drainshield_wifi/secrets.h
